<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kuiz Interaktif: Solat Jamak & Qasar</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .option-btn {
            transition: all 0.2s ease-in-out;
        }
        .option-btn:hover {
            transform: translateY(-2px);
        }
        @keyframes pulse-light {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }
        .pulse-anim {
            animation: pulse-light 2s infinite;
        }
    </style>
</head>
<body class="flex items-center justify-center p-4">

    <div class="w-full max-w-2xl glass-card rounded-3xl shadow-2xl overflow-hidden p-6 md:p-8 my-6">

        <!-- HEADER -->
        <div class="text-center mb-6">
            <span class="bg-emerald-100 text-emerald-800 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">Fiqh Ibadah</span>
            <h1 class="text-2xl md:text-3xl font-bold text-slate-800 mt-2">Cabaran Solat Jamak & Qasar</h1>
            <p class="text-slate-500 text-sm mt-1">Uji kefahaman anda mengenai rukhsah (kemudahan) solat semasa bermusafir!</p>
        </div>

        <!-- SCREEN 1: START CARD -->
        <div id="start-screen" class="text-center py-6">
            <div class="w-24 h-24 bg-emerald-500/10 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-6 text-4xl pulse-anim">
                <i class="fa-solid fa-compass"></i>
            </div>
            <ul class="text-left bg-slate-50 p-4 rounded-xl text-slate-600 text-sm space-y-2 mb-6 border border-slate-100">
                <li class="flex items-center"><i class="fa-solid fa-circle-check text-emerald-500 mr-2"></i> 5 soalan pilihan ganda berpaksikan fiqh sahih.</li>
                <li class="flex items-center"><i class="fa-solid fa-circle-check text-emerald-500 mr-2"></i> Penjelasan jawapan disediakan selepas setiap soalan.</li>
                <li class="flex items-center"><i class="fa-solid fa-circle-check text-emerald-500 mr-2"></i> Tiada had masa, fikir dan fahami dengan tenang!</li>
            </ul>
            <button onclick="startQuiz()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-lg shadow-emerald-600/30 transition transform hover:-translate-y-0.5">
                Mula Kuiz Sekarang <i class="fa-solid fa-arrow-right ml-2"></i>
            </button>
        </div>

        <!-- SCREEN 2: QUIZ CARD -->
        <div id="quiz-screen" class="hidden">
            <!-- Progress Bar -->
            <div class="mb-6">
                <div class="flex justify-between text-xs font-semibold text-slate-500 mb-2">
                    <span id="question-count">Soalan 1 daripada 5</span>
                    <span id="score-count">Skor: 0</span>
                </div>
                <div class="w-full bg-slate-200 h-2.5 rounded-full overflow-hidden">
                    <div id="progress-bar" class="bg-emerald-500 h-2.5 rounded-full transition-all duration-300" style="width: 20%"></div>
                </div>
            </div>

            <!-- Question & Options -->
            <div class="mb-6">
                <h2 id="question-text" class="text-lg md:text-xl font-semibold text-slate-800 mb-4"></h2>
                <div id="options-container" class="space-y-3"></div>
            </div>

            <!-- Explanation Box -->
            <div id="explanation-box" class="hidden p-4 rounded-xl mb-6 border text-sm">
                <p id="explanation-title" class="font-bold mb-1"></p>
                <p id="explanation-text" class="text-slate-600 leading-relaxed"></p>
            </div>

            <!-- Next Button -->
            <button id="next-btn" onclick="nextQuestion()" class="hidden w-full bg-slate-800 hover:bg-slate-900 text-white font-semibold py-3 px-6 rounded-xl transition">
                Soalan Seterusnya <i class="fa-solid fa-chevron-right ml-1"></i>
            </button>
        </div>

        <!-- SCREEN 3: RESULT CARD -->
        <div id="result-screen" class="hidden text-center py-6">
            <div id="result-icon" class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl"></div>
            <h2 id="result-title" class="text-2xl font-bold text-slate-800 mb-1"></h2>
            <p id="result-message" class="text-slate-500 text-sm mb-6"></p>

            <div class="bg-slate-50 p-6 rounded-2xl border border-slate-100 mb-6">
                <p class="text-xs uppercase tracking-wider text-slate-400 font-bold mb-1">Skor Akhir Anda</p>
                <p id="final-score" class="text-4xl font-extrabold text-emerald-600">0 / 5</p>
            </div>

            <button onclick="restartQuiz()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3.5 px-6 rounded-xl shadow-lg transition">
                <i class="fa-solid fa-rotate-right mr-2"></i> Cuba Lagi
            </button>
        </div>

    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        const quizData = [
            {
                question: "Apakah maksud dari segi bahasa bagi perkataan 'Qasar' dalam solat?",
                options: [
                    "Himpun / Kumpul",
                    "Memendekkan / Memendekkan solat 4 rakaat jadi 2",
                    "Melambat-lambatkan waktu",
                    "Mengulang solat"
                ],
                correct: 1,
                explanation: "Secara bahasa, 'Qasar' bermaksud memendekkan. Dari segi istilah fiqh, ia bermaksud memendekkan solat fardhu 4 rakaat (Zohor, Asar, Isyak) menjadi 2 rakaat."
            },
            {
                question: "Antara solat berikut, solat manakah yang BOLEH di-Qasarkan?",
                options: [
                    "Subuh, Zohor, dan Asar",
                    "Maghrib dan Isyak sahaja",
                    "Zohor, Asar, dan Isyak",
                    "Semua solat fardhu 5 waktu"
                ],
                correct: 2,
                explanation: "Qasar HANYA boleh dilakukan pada solat fardhu 4 rakaat sahaja iaitu Zohor, Asar, dan Isyak. Solat Subuh dan Maghrib tidak boleh di-Qasarkan."
            },
            {
                question: "Apakah syarat jarak minimum (perjalanan) yang membolehkan seseorang melakukan solat Jamak dan Qasar?",
                options: [
                    "2 Marhalah (Anggaran 81 km - 89 km)",
                    "1 Marhalah (Anggaran 40 km)",
                    "100 Meter",
                    "Mesti melepasi 500 km"
                ],
                correct: 0,
                explanation: "Syarat sah jarak perjalanan bagi harus melakukan Jamak & Qasar mengikut mazhab Syafi'i ialah sekurang-kurangnya 2 marhalah (dianggarkan antara 81 km hingga 89 km)."
            },
            {
                question: "Apakah nama bagi jenis jamak yang menghimpunkan dua solat dan menunaikannya dalam WAKTU SOLAT YANG PERTAMA (cth: Solat Asar dalam waktu Zohor)?",
                options: [
                    "Jamak Takhir",
                    "Jamak Taqdim",
                    "Jamak Qasar",
                    "Jamak Qada"
                ],
                correct: 1,
                explanation: "Jamak Taqdim ialah menghimpunkan solat kedua ke dalam waktu solat pertama. Manakala Jamak Takhir ialah melambatkan solat pertama untuk ditunaikan dalam waktu solat kedua."
            },
            {
                question: "Berapakah had tempoh maksimum seorang musafir boleh melakukan jamak & qasar jika dia berniat menetap di sesuatu tempat (tidak termasuk hari sampai & keluar)?",
                options: [
                    "2 Hari",
                    "3 Hari 3 Malam",
                    "7 Hari",
                    "1 bulan"
                ],
                correct: 1,
                explanation: "Jika musafir berniat tinggal di sesuatu destinasi melebihi 3 hari (tidak termasuk hari masuk & keluar), dia dikira bermukim sebaik sahaja tiba dan tidak lagi harus menjamak/menqasarkan solat di destinasi tersebut."
            }
        ];

        let currentQuestion = 0;
        let score = 0;
        let selectedOption = null;

        function startQuiz() {
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            showQuestion();
        }

        function showQuestion() {
            const data = quizData[currentQuestion];
            document.getElementById('question-count').innerText = `Soalan ${currentQuestion + 1} daripada ${quizData.length}`;
            document.getElementById('score-count').innerText = `Skor: ${score}`;
            document.getElementById('progress-bar').style.width = `${((currentQuestion + 1) / quizData.length) * 100}%`;
            
            document.getElementById('question-text').innerText = data.question;
            
            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            data.options.forEach((option, index) => {
                const btn = document.createElement('button');
                btn.className = `option-btn w-full text-left p-4 rounded-xl border border-slate-200 bg-white hover:border-emerald-500 hover:bg-emerald-50/50 font-medium text-slate-700 flex justify-between items-center transition`;
                btn.innerHTML = `<span>${option}</span> <i class="fa-regular fa-circle text-slate-300"></i>`;
                btn.onclick = () => selectOption(index, btn);
                optionsContainer.appendChild(btn);
            });

            // Reset box penjelasan & butang seterusnya
            document.getElementById('explanation-box').classList.add('hidden');
            document.getElementById('next-btn').classList.add('hidden');
            selectedOption = null;
        }

        function selectOption(index, btn) {
            if (selectedOption !== null) return; // Kunci pilihan selepas klik
            selectedOption = index;

            const data = quizData[currentQuestion];
            const allButtons = document.getElementById('options-container').children;

            if (index === data.correct) {
                score++;
                btn.classList.remove('border-slate-200', 'bg-white');
                btn.classList.add('border-emerald-500', 'bg-emerald-100', 'text-emerald-900');
                btn.querySelector('i').className = 'fa-solid fa-circle-check text-emerald-600';
                showExplanation(true, data.explanation);
            } else {
                btn.classList.remove('border-slate-200', 'bg-white');
                btn.classList.add('border-rose-500', 'bg-rose-100', 'text-rose-900');
                btn.querySelector('i').className = 'fa-solid fa-circle-xmark text-rose-600';

                // Tunjukkan jawapan yang betul
                allButtons[data.correct].classList.remove('border-slate-200', 'bg-white');
                allButtons[data.correct].classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900');
                allButtons[data.correct].querySelector('i').className = 'fa-solid fa-circle-check text-emerald-600';
                
                showExplanation(false, data.explanation);
            }

            document.getElementById('score-count').innerText = `Skor: ${score}`;
            document.getElementById('next-btn').classList.remove('hidden');
        }

        function showExplanation(isCorrect, text) {
            const expBox = document.getElementById('explanation-box');
            const expTitle = document.getElementById('explanation-title');
            const expText = document.getElementById('explanation-text');

            expBox.classList.remove('hidden');
            if (isCorrect) {
                expBox.className = "p-4 rounded-xl mb-6 border text-sm bg-emerald-50 border-emerald-200 text-emerald-900";
                expTitle.innerText = "Tepat Sekali! 🎉";
            } else {
                expBox.className = "p-4 rounded-xl mb-6 border text-sm bg-rose-50 border-rose-200 text-rose-900";
                expTitle.innerText = "Kurang Tepat! 💡";
            }
            expText.innerText = text;
        }

        function nextQuestion() {
            currentQuestion++;
            if (currentQuestion < quizData.length) {
                showQuestion();
            } else {
                showResult();
            }
        }

        function showResult() {
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            const finalScoreElem = document.getElementById('final-score');
            const resultTitle = document.getElementById('result-title');
            const resultMsg = document.getElementById('result-message');
            const resultIcon = document.getElementById('result-icon');

            finalScoreElem.innerText = `${score} / ${quizData.length}`;

            if (score === quizData.length) {
                resultIcon.className = "w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl bg-emerald-100 text-emerald-600";
                resultIcon.innerHTML = `<i class="fa-solid fa-trophy"></i>`;
                resultTitle.innerText = "Cemerlang & Sempurna!";
                resultMsg.innerText = "Tahniah! Anda mempunyai kefahaman yang amat mendalam mengenai rukun dan syarat Solat Jamak & Qasar.";
            } else if (score >= 3) {
                resultIcon.className = "w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl bg-blue-100 text-blue-600";
                resultIcon.innerHTML = `<i class="fa-solid fa-thumbs-up"></i>`;
                resultTitle.innerText = "Syabas & Tahniah!";
                resultMsg.innerText = "Penguasaan anda agak baik! Teruskan mengulang kaji fiqh ibadah untuk pemahaman yang lebih mantap.";
            } else {
                resultIcon.className = "w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl bg-amber-100 text-amber-600";
                resultIcon.innerHTML = `<i class="fa-solid fa-book-open"></i>`;
                resultTitle.innerText = "Jangan Putus Asa!";
                resultMsg.innerText = "Cuba semak semula nota panduan Jamak & Qasar dan lakukan cabaran ini sekali lagi.";
            }
        }

        function restartQuiz() {
            currentQuestion = 0;
            score = 0;
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            showQuestion();
        }
    </script>
</body>
</html>
